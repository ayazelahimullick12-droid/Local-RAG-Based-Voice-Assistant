# Copy to config/.env and edit. Loaded by assistant/config.py (pydantic-settings).
# Every tunable in the project lives here — nothing latency/model-related
# should be hardcoded in the Python source.

# ---------------------------------------------------------------------------
# Audio I/O
# ---------------------------------------------------------------------------
# Device name/index for sounddevice; leave blank to use the OS default.
# Run `python -c "import sounddevice as sd; print(sd.query_devices())"` to list.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
AUDIO_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# VAD (Silero, CPU)
# ---------------------------------------------------------------------------
VAD_START_THRESHOLD=0.5
# End-of-speech silence before we treat the utterance as finished. Spec target: 500ms.
VAD_END_SILENCE_MS=500
# Ignore speech bursts shorter than this (avoids false triggers on clicks/coughs).
VAD_MIN_SPEECH_MS=200

# ---------------------------------------------------------------------------
# STT — switch engine here; all three implement the same interface (stt/base.py)
# ---------------------------------------------------------------------------
# bangla_asr      -> bangla-speech-processing/BanglaASR (Whisper-small, MIT, 4.58% WER) — PRIMARY
# nemo_conformer  -> kazalbrur/bangla-stt-conformer-120m-dialects (NeMo, Apache-2.0, ~27% WER, no punctuation)
# indic_conformer -> ai4bharat/indic-conformer-600m-multilingual (MIT, transformers, CTC/RNNT)
STT_ENGINE=bangla_asr
STT_MODEL_ID=bangla-speech-processing/BanglaASR
STT_DEVICE=cuda
STT_DTYPE=bfloat16
STT_LANGUAGE=bn
# For nemo_conformer only: exact .nemo filename inside the HF repo. Leave
# blank to auto-detect the first *.nemo file via huggingface_hub.list_repo_files.
STT_NEMO_FILENAME=
# For indic_conformer only: "ctc" or "rnnt"
STT_INDIC_DECODING=ctc
# Streaming re-transcription cadence while the user is still talking.
STT_PARTIAL_INTERVAL_MS=300

# ---------------------------------------------------------------------------
# LLM (Ollama, streaming)
# ---------------------------------------------------------------------------
# Verified real & current on ollama.com/library as of Sept 2026:
#   gemma4:26b        -> MoE, 25.2B total / 3.8B active, ~19GB, matches spec target — DEFAULT
#   gemma4:e4b         -> lightweight fallback if 26b is too slow
#   qwen3.5:35b-a3b    -> MoE A/B candidate, 35B total / ~3B active
#   qwen3.6:35b-a3b    -> newer Qwen A/B candidate
LLM_MODEL=gemma4:26b
LLM_HOST=http://localhost:11434
LLM_TEMPERATURE=0.6
LLM_NUM_PREDICT_NORMAL=120
LLM_NUM_PREDICT_GREETING=40
# Passed as a top-level `think=` kwarg to ollama.AsyncClient.chat() — verify
# your installed ollama-python version honors it (some versions have had
# inconsistent handling; see ollama/ollama-python#529).
LLM_THINK=false
LLM_KEEP_ALIVE=-1

# ---------------------------------------------------------------------------
# TTS — switch engine here; all three implement the same interface (tts/base.py)
# ---------------------------------------------------------------------------
# emtiazz_vits -> EMTIAZZ/bangladeshi-bangla-tts-vits (Coqui-VITS, Apache-2.0, Bangladeshi accent) — PRIMARY
# mms_tts      -> facebook/mms-tts-ben (VITS via transformers, CC-BY-NC-4.0 NON-COMMERCIAL, 16kHz)
# indic_parler -> ai4bharat/indic-parler-tts (0.9B, Apache-2.0, Arjun/Aditi voices, Indian accent, slower)
TTS_ENGINE=emtiazz_vits
TTS_DEVICE=cuda
# indic_parler only — voice + delivery description prompt
TTS_PARLER_VOICE_DESCRIPTION=Aditi speaks in Bengali with a clear, warm, moderate-pace, neutral tone.

# ---------------------------------------------------------------------------
# Proactive filler phrases
# ---------------------------------------------------------------------------
FILLER_ENABLED=true
# Play a filler only if real answer audio hasn't started within this long.
FILLER_TRIGGER_MS=700
FILLER_PHRASES=একটু দেখি…,আচ্ছা বলছি…,হুম এক মিনিট…,ভালো প্রশ্ন…,ঠিক আছে দেখছি…,একটু সময় দিন…,বুঝেছি বলছি…,হ্যাঁ ভাবছি…

# ---------------------------------------------------------------------------
# Barge-in
# ---------------------------------------------------------------------------
# NOTE: there is no acoustic echo cancellation (AEC) in this project. On a
# plain USB mic + speaker setup, the mic can pick up the assistant's own
# voice and falsely trigger barge-in. Use headphones, or a USB speakerphone
# with built-in hardware AEC (e.g. Jabra/Anker conference units), for
# reliable behaviour. See README Troubleshooting.
BARGE_IN_ENABLED=true

# ---------------------------------------------------------------------------
# RAG (lowest priority; keep simple/fast)
# ---------------------------------------------------------------------------
RAG_ENABLED=true
RAG_KNOWLEDGE_DIR=knowledge
RAG_CACHE_PATH=knowledge/.embed_cache.json
RAG_CHUNK_CHARS=900
RAG_TOP_K=3
RAG_MIN_SCORE=0.15
RAG_EMBED_MODEL=bge-m3
# 0.65 * embedding_cosine + 0.35 * (0.6*word_tfidf + 0.4*char_trigram_tfidf)
RAG_WEIGHT_EMBED=0.65
RAG_WEIGHT_TFIDF=0.35
RAG_WEIGHT_TFIDF_WORD=0.6
RAG_WEIGHT_TFIDF_CHAR=0.4

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LATENCY_LOG_PATH=logs/latency.jsonl
LOG_LEVEL=INFO
